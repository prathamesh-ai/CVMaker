d")\n    40\t    with pdfplumber.open(file_path) as pdf:\n    41\t        text = "\\n".join(page.extract_text() or "" for page in pdf.pages)\n    42\t    return text\n    43\t\n    44\t\n    45\tdef extract_from_docx(file_path: str) -> str:\n    46\t    if Document is None:\n    47\t        raise ImportError("python-docx not installed")\n    48\t    doc = Document(file_path)\n    49\t    text = "\\n".join(p.text for p in doc.paragraphs if p.text)\n    50\t    return text\n    51\t\n    52\t\n    53\tdef copy_jd_file(jd_path: str, output_path: str) -> bool:\n    54\t    """Copy Job Description file to output directory."""\n    55\t    jd_file = Path(jd_path)\n    56\t    if not jd_file.exists():\n    57\t        return False\n    58\t    \n    59\t    content = jd_file.read_text(encoding="utf-8")\n    60\t    out_path = Path(output_path)\n    61\t    out_path.parent.mkdir(parents=True, exist_ok=True)\n    62\t    with open(out_path, "w") as f:\n    63\t        f.write(content)\n    64\t    return True\n    65\t\n    66\t\n    67\tdef parse_cv_with_llm(text: str) -> dict:\n    68\t    """Use LLM to parse raw CV text into structured JSON."""\n    69\t    client = get_llm_client()\n    70\t    if not client:\n    71\t        print("No LLM client available", file=sys.stderr)\n    72\t        return None\n    73\t    \n    74\t    prompt = f"""Extract the following resume text into a structured JSON format.\n    75\t\n    76\tResume text:\n    77\t{text}\n    78\t\n    79\tReturn ONLY valid JSON (no markdown formatting) with this structure:\n    80\t{{\n    81\t  "contact": {{\n    82\t    "name": "Full Name",\n    83\t    "email": "email@example.com", \n    84\t    "phone": "+1 234 567 8900",\n    85\t    "location": "City, State",\n    86\t    "linkedin": "linkedin.com/in/username or empty string",\n    87\t    "github": "github.com/username or empty string"\n    88\t  }},\n    89\t  "summary": "2-3 sentence professional summary",\n    90\t  "experience": [\n    91\t    {{\n    92\t      "company": "Company Name",\n    93\t      "position": "Job Title",\n    94\t      "duration": "Jan 2020 - Present or similar format",\n    95\t      "description": ["Bullet point 1", "Bullet point 2", "Bullet point 3"]\n    96\t    }}\n    97\t  ],\n    98\t  "education": [\n    99\t    {{\n   100\t      "institution": "University Name",', name='read_file', id='16926db8-0cb6-4504-8e3b-14097df3d577', tool_call_id='svTYvGf6m'), AIMessage(content='', additional_kwargs={}, response_metadata={'model_name': 'mistralai/mistral-small-2603', 'id': 'gen-1776881534-i9ORvzA10wovyMzOFhQv', 'created': 1776881534, 'object': 'chat.completion', 'finish_reason': 'tool_calls', 'logprobs': None, 'model_provider': 'openrouter'}, id='lc_run--019db664-8744-7763-9f09-3874598500af-0', tool_calls=[{'name': 'execute', 'args': {'command': 'python "skills/active/parse-cv/tools/main.py" "/users/admin/VSCode/LatexCVMaker/input/resume.pdf" "/users/admin/VSCode/LatexCVMaker/output/cv_data.json" "/users/admin/VSCode/LatexCVMaker/input/jd.txt"', 'timeout': 120}, 'id': 'HvU0pJaG5', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 11335, 'output_tokens': 85, 'total_tokens': 11420, 'input_token_details': {'cache_read': 10016, 'cache_creation': 0}, 'output_token_details': {'reasoning': 0}}), ToolMessage(content="[stderr] 'python' is not recognized as an internal or external command,\n[stderr] operable program or batch file.\n\nExit code: 1\n[Command failed with exit code 1]", name='execute', id='4668b7db-290f-4161-adba-f8721fc11a97', tool_call_id='HvU0pJaG5'), AIMessage(content='', additional_kwargs={}, response_metadata={'model_name': 'mistralai/mistral-small-2603', 'id': 'gen-1776881535-sezpbNwh5V5FzwpUqxEz', 'created': 1776881535, 'object': 'chat.completion', 'finish_reason': 'tool_calls', 'logprobs': None, 'model_provider': 'openrouter'}, id='lc_run--019db664-8b42-7dc0-ae3d-70f2bc997b39-0', tool_calls=[{'name': 'execute', 'args': {'command': 'where pyth